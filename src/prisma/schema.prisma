// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  name       String       
  /// 0 - 100 value 0 banned, 45 unverified user (no email verification), 50 user, 100 admin 
  privilege  Int
  email      String     @unique
  password   String

  profile    UserProfile?

  // Email verificatie
  verificationToken   String?
  verificationExpiry  DateTime?

  createdAt  DateTime   @default(now())
}

model UserProfile {
  id        Int       @id @default(autoincrement())
  /// 0 for male, 1 for female, 2 for other
  gender    Int
  target_gender Int
  bio       String?
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id])
  interests InterestsOnProfiles[]
  createdAt  DateTime   @default(now())
}

model InterestCategory {
  id        Int         @id @default(autoincrement())
  interests Interest[]
}

model Interest {
  id            Int       @id @default(autoincrement())
  name          String
  priority      Int
  user_profiles InterestsOnProfiles[]
  category      InterestCategory        @relation(fields: [category_id], references: [id])
  category_id   Int
  createdAt  DateTime   @default(now())
}

model InterestsOnProfiles {
  user_profile  UserProfile   @relation(fields: [profile_id], references: [id])
  profile_id    Int
  interest      Interest      @relation(fields: [interest_id], references: [id])
  interest_id   Int
  createdAt  DateTime   @default(now())
  @@id([profile_id, interest_id])
}
